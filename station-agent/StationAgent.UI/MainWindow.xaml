<Window
    x:Class="StationAgent.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gaming Center Station"
    Width="520"
    Height="300"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="32">
        <StackPanel
            VerticalAlignment="Center">

            <TextBlock
                Text="Gaming Center"
                FontSize="30"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="StationCodeText"
                Text="Conectando..."
                FontSize="22"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="ConnectionStatusText"
                Text="IPC: esperando servicio"
                FontSize="14"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"/>
                
            <TextBlock
                x:Name="BackendStatusText"
                Text="Backend: esperando estado"
                FontSize="14"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>